# ScamShield Configuration

## Application
APP_NAME=ScamShield
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=info

## Server
HOST=0.0.0.0
PORT=8000
WORKERS=4

## CORS
CORS_ORIGINS=http://localhost,http://localhost:3000,http://localhost:5173

## ML Model
MODEL_PATH=models/scam_classifier.pkl
VECTORIZER_PATH=models/vectorizer.pkl

## OCR
TESSERACT_CMD=tesseract
OCR_ENABLED=true

## Connectors
# Google Safe Browsing API key (optional)
GOOGLE_SAFE_BROWSING_API_KEY=
# Cache TTL for connector results (seconds)
CONNECTOR_CACHE_TTL=300

## Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

## Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090
