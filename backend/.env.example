# ============================================================================
# Kaaval Backend — Environment Configuration
# ============================================================================
# Copy this file to .env and adjust for your environment.
#   cp .env.example .env
# ============================================================================

# --- Environment -----------------------------------------------------------
SCAMSHIELD_ENVIRONMENT=development
# Valid: development, staging, production

# --- ML Model & Data Paths -------------------------------------------------
# Paths are relative to backend/ directory
SCAMSHIELD_MODEL_PATH=models/model.joblib
SCAMSHIELD_VECTORIZER_PATH=models/vectorizer.joblib
SCAMSHIELD_DATASET_PATH=data/scam_dataset.csv

# --- Input Validation ------------------------------------------------------
SCAMSHIELD_MAX_TEXT_LENGTH=10000
SCAMSHIELD_MAX_FILE_SIZE_MB=10

# --- Connectors (Threat Intelligence) --------------------------------------
SCAMSHIELD_CONNECTOR_ENABLED=true
SCAMSHIELD_CONNECTOR_TIMEOUT=10
SCAMSHIELD_CONNECTOR_RETRY_COUNT=1
SCAMSHIELD_CONNECTOR_PARALLELISM=4
SCAMSHIELD_CONNECTOR_CACHE_TTL=300
SCAMSHIELD_CONNECTOR_MAX_RESULTS=10

# --- Google Safe Browsing --------------------------------------------------
SCAMSHIELD_SAFE_BROWSING_ENABLED=true
# Obtain from https://developers.google.com/safe-browsing/v4/get-started
SCAMSHIELD_SAFE_BROWSING_API_KEY=
SCAMSHIELD_SAFE_BROWSING_TIMEOUT=15
SCAMSHIELD_SAFE_BROWSING_CACHE_TTL=300
SCAMSHIELD_SAFE_BROWSING_MAX_BATCH=500

# --- CORS ------------------------------------------------------------------
# Comma-separated list of allowed origins.
# Production MUST set this to specific origins (NOT wildcard).
# Examples:
#   SCAMSHIELD_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
#   SCAMSHIELD_CORS_ORIGINS=https://app.kaaval.com
SCAMSHIELD_CORS_ORIGINS=http://localhost,http://localhost:3000,http://localhost:5173

# --- Rate Limiting ---------------------------------------------------------
SCAMSHIELD_RATE_LIMIT_MAX=100
SCAMSHIELD_RATE_LIMIT_WINDOW=60
SCAMSHIELD_MAX_REQUEST_BODY_MB=10

# --- Authentication --------------------------------------------------------
# Enable auth layer (false = all endpoints public)
SCAMSHIELD_AUTH_ENABLED=false
# Generate a strong random secret for JWT signing:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SCAMSHIELD_JWT_SECRET=
SCAMSHIELD_JWT_ACCESS_TTL=3600
SCAMSHIELD_JWT_REFRESH_TTL=2592000
# Admin API key for minting admin tokens (required when AUTH_ENABLED=true)
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SCAMSHIELD_ADMIN_API_KEY=
# Clock skew tolerance in seconds for JWT validation (max 300)
SCAMSHIELD_JWT_CLOCK_SKEW=30

# --- Logging ---------------------------------------------------------------
SCAMSHIELD_LOG_LEVEL=INFO
SCAMSHIELD_LOG_FORMAT=text
# Valid: text, json
SCAMSHIELD_LOG_OUTPUT=stdout
# Valid: stdout, file, both
SCAMSHIELD_LOG_FILE=
SCAMSHIELD_LOG_MAX_BYTES=10485760
SCAMSHIELD_LOG_BACKUP_COUNT=5

# --- Feature Flags ---------------------------------------------------------
SCAMSHIELD_TEST_MODE=false
