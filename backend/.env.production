# Kaaval Backend — Production Configuration
# Copy/render these env vars on your deployment platform.

SCAMSHIELD_ENVIRONMENT=production

# CORS — MUST set to your frontend domain
SCAMSHIELD_CORS_ORIGINS=https://kaaval-frontend.vercel.app

# Auth — REQUIRED in production
SCAMSHIELD_AUTH_ENABLED=true
SCAMSHIELD_JWT_SECRET=change-this-to-a-strong-random-secret
SCAMSHIELD_ADMIN_API_KEY=change-this-to-a-strong-random-api-key

# Rate limiting
SCAMSHIELD_RATE_LIMIT_MAX=100
SCAMSHIELD_RATE_LIMIT_WINDOW=60

# Logging
SCAMSHIELD_LOG_LEVEL=INFO
SCAMSHIELD_LOG_FORMAT=json

# Feature flags
SCAMSHIELD_TEST_MODE=false
