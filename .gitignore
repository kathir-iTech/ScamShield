__pycache__/
*.pyc
venv/
.env
node_modules/
.env.local
dist/
build/
*.pt
.DS_Store
*.env.production

# runtime prediction logs — regenerated by the app, not source
backend/logs/predictions/*.jsonl

# regenerable OCR test artifacts — keep generator, not binaries
experiments/ocr_test_images/
experiments/ocr_test_images_noisy/
experiments/*.json

# regenerated pipeline/model JS exports + tesseract language binary
experiments/*.traineddata
experiments/model.js
experiments/vectorizer.js
experiments/pipeline.js
experiments/repair_urls.js

# dead experiment artifacts — regenerated on demand, never loaded by the app.
# model.joblib / vectorizer.joblib are intentionally tracked and NOT ignored.
backend/models/*.base.*
backend/models/*.gamma.*
backend/models/*.log
frontend/src/lib/scamshield/*.base.js

# runtime SQLite store
backend/data/*.db
backend/data/*.db-wal
backend/data/*.db-shm

# generated labelling + evaluation output
datasets/gold/label_queue.csv
evaluation/reports/ci_gate/

# test runner output
frontend/test-results/
frontend/playwright-report/
.pytest_cache/
